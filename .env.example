APP_NAME="Company OS"
APP_URL=https://company-os.jp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_DISPLAY_TIMEZONE=Asia/Tokyo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local/test capture only. Production must use a configured delivery mailer such as smtp.
ACCOUNT_MAIL_MAILER=array
ACCOUNT_LOGIN_MAX_ATTEMPTS_PER_MINUTE=5
ACCOUNT_LOGIN_MAX_ATTEMPTS_PER_IP_PER_MINUTE=30
ACCOUNT_LOGIN_DECAY_SECONDS=60
ACCOUNT_MAIL_MAX_PER_MINUTE=1
ACCOUNT_MAIL_MAX_PER_HOUR=5
ACCOUNT_EMAIL_TOKEN_EXPIRE_MINUTES=60
ACCOUNT_TOKEN_MAX_ATTEMPTS_PER_MINUTE=10

# Scope 6 Owner Onboarding remains closed until official documents are published.
OWNER_ONBOARDING_EXPIRES_DAYS=7
OWNER_ONBOARDING_CLAIM_MINUTES=30
OWNER_ONBOARDING_RESEND_COOLDOWN_SECONDS=60
OWNER_ONBOARDING_MAX_REQUESTS_PER_MINUTE=10
OWNER_ONBOARDING_LEGAL_DOCUMENTS_PUBLISHED=false
OWNER_ONBOARDING_TERMS_VERSION=
OWNER_ONBOARDING_TERMS_CONTENT_HASH=
OWNER_ONBOARDING_TERMS_URL=
OWNER_ONBOARDING_PRIVACY_VERSION=
OWNER_ONBOARDING_PRIVACY_CONTENT_HASH=
OWNER_ONBOARDING_PRIVACY_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_INPUT_USD_PER_MILLION=2.50
OPENAI_OUTPUT_USD_PER_MILLION=15.00
AI_SCOPE_ONE_APPLY_ENABLED=true
AI_SCOPE_ONE_CONTEXT_MAX_ENTITIES=500
AI_SCOPE_ONE_CONTEXT_MAX_CHARS=100000
